<UserControl x:Class="GameBoost.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GameBoost.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource PageRoot}">
        <StackPanel Margin="0,0,10,0">
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Games.Title}" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="{DynamicResource Games.Subtitle}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Command="{Binding AddManualCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Games.Add}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RescanCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Games.Rescan}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card.Glass}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.H2}" VerticalAlignment="Center" />
                        <TextBox HorizontalAlignment="Right" Width="240" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource Games.Search}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Games}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GameItemViewModel}">
                                <Border Background="{StaticResource B.Bg3}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8"
                                        BorderBrush="{StaticResource B.Border}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource B.Bg4}" Margin="0,0,14,0">
                                            <Image Source="{Binding ExePath, Converter={StaticResource PathToIcon}}" Width="22" Height="22" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ProfileText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Source}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Padding="12,6" Margin="0,0,6,0" Content="{DynamicResource Games.CreateProfile}" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.CreateProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                            <Button Style="{StaticResource Button.Primary}" Padding="14,6" Margin="0,0,6,0" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE768;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource B.OnAccent}" />
                                                    <TextBlock Text="{DynamicResource Games.Play}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Button.IconGhost}" Content="&#xE74D;" ToolTip="{DynamicResource Games.Remove}" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.RemoveManualCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Visibility="{Binding IsManual, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{DynamicResource Games.Scanning}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,20"
                               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{DynamicResource Games.Empty}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,20" TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{DynamicResource Games.Hint}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
