<Window x:Class="GameBoost.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameBoost"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Foreground="{StaticResource B.Text}"
        UseLayoutRounding="True">
    <Border Margin="16"
            Background="{StaticResource B.Bg2}"
            BorderBrush="{StaticResource B.BorderStrong}"
            BorderThickness="1"
            CornerRadius="14"
            MouseLeftButtonDown="OnDragArea">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="24,22,24,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="IconText"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{StaticResource B.Accent}" />
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.H2}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="MessageText"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       FontSize="13.5"
                       LineHeight="20"
                       Foreground="{StaticResource B.TextDim}" />
            <TextBox x:Name="InputBox" Margin="0,14,0,0" Visibility="Collapsed" KeyDown="OnInputKeyDown" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" MinWidth="96" Margin="0,0,10,0" Click="OnCancel" IsCancel="True" />
                <Button x:Name="OkButton" MinWidth="96" Style="{StaticResource Button.Primary}" Click="OnOk" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
