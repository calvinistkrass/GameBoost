<UserControl x:Class="GameBoost.Views.GameModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:GameBoost.Models">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{DynamicResource GM.Title}" Style="{StaticResource Text.H1}" />
            <TextBlock Text="{DynamicResource GM.Subtitle}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Toggle + status -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource Button.GameMode}" Tag="{Binding IsActive}" Command="{Binding ToggleCommand}"
                            ToolTip="{DynamicResource GM.Toggle.Tooltip}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="34" HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource GM.Toggle.Title}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding ToggleState}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource GM.Profile}" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource Button.Icon}" Content="&#xE710;" Command="{Binding NewProfileCommand}" ToolTip="{DynamicResource GM.NewProfile}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource Button.Icon}" Content="&#xE70F;" Command="{Binding RenameProfileCommand}" ToolTip="{DynamicResource GM.RenameProfile}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource Button.Icon}" Content="&#xE8C8;" Command="{Binding DuplicateProfileCommand}" ToolTip="{DynamicResource GM.DuplicateProfile}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource Button.Icon}" Content="&#xE74D;" Command="{Binding DeleteProfileCommand}" ToolTip="{DynamicResource GM.DeleteProfile}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource Button.Icon}" Content="&#xEDE1;" Command="{Binding ExportProfileCommand}" ToolTip="{DynamicResource GM.ExportProfile}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource Button.Icon}" Content="&#xE8B5;" Command="{Binding ImportProfileCommand}" ToolTip="{DynamicResource GM.ImportProfile}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource GM.HotkeyHint}" Style="{StaticResource Text.Muted}" FontSize="11.5" Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource B.TextFaint}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource B.Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource B.Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusHeadline}" Style="{StaticResource Text.H2}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding StatusSubline}" Style="{StaticResource Text.Muted}" Margin="20,4,0,12" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DisplayEntries}" Margin="20,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:StatusEntry}">
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock x:Name="Glyph" Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="{StaticResource B.Accent2}" Width="22" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StatusKind.Ok}">
                                            <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource B.Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StatusKind.Warning}">
                                            <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource B.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StatusKind.Error}">
                                            <Setter TargetName="Glyph" Property="Text" Value="&#xEA39;" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource B.Danger}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Tabs -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,14,16,12">
                    <RadioButton Style="{StaticResource RadioButton.Tab}" Content="{DynamicResource GM.Tab.Kill}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsToBool}, ConverterParameter=Kill}" />
                    <RadioButton Style="{StaticResource RadioButton.Tab}" Content="{DynamicResource GM.Tab.Start}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsToBool}, ConverterParameter=Start}" />
                    <RadioButton Style="{StaticResource RadioButton.Tab}" Content="{DynamicResource GM.Tab.Options}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsToBool}, ConverterParameter=Options}" />
                    <RadioButton Style="{StaticResource RadioButton.Tab}" Content="{DynamicResource GM.Tab.Auto}"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsToBool}, ConverterParameter=Auto}" />
                </StackPanel>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource B.Border}" />

                <Grid Margin="18,14,18,16">
                    <!-- ===== Close programs ===== -->
                    <DockPanel Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=Kill}">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="360" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource GM.Search}" />
                            <TextBlock Grid.Column="2" Text="{Binding SelectedCountText}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="12,0" />
                            <Button Grid.Column="3" Style="{StaticResource Button.Ghost}" Content="{DynamicResource GM.SelectNone}" Command="{Binding SelectNoneCommand}" Margin="0,0,6,0" />
                            <Button Grid.Column="4" Command="{Binding RefreshProcessesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="{DynamicResource GM.Refresh}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border DockPanel.Dock="Top" Style="{StaticResource InfoBox}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE83D;" Style="{StaticResource Text.Icon}" Foreground="{StaticResource B.Accent2}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource GM.Kill.SafetyHint}" Style="{StaticResource Text.Muted}" />
                            </Grid>
                        </Border>
                        <Grid>
                            <ListBox ItemsSource="{Binding ProcessesView}" ItemContainerStyle="{StaticResource ListBoxItem.Plain}"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource CheckBox.Box}" IsChecked="{Binding IsSelected}" Margin="0,1">
                                            <Grid Height="38">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource B.TextFaint}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding InfoText}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                            </Grid>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{DynamicResource GM.Loading}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsLoadingProcesses, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </DockPanel>

                    <!-- ===== Start programs ===== -->
                    <DockPanel Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=Start}">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource GM.Start.Hint}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Command="{Binding AddProgramCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{DynamicResource GM.Start.Add}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid>
                            <ListBox ItemsSource="{Binding SelectedProfile.ProgramsToStart}" ItemContainerStyle="{StaticResource ListBoxItem.Plain}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:StartProgram}">
                                        <Border Background="{StaticResource B.Bg3}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Path, Converter={StaticResource PathToIcon}}" Width="22" Height="22" HorizontalAlignment="Left" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource B.TextFaint}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource Button.IconGhost}" Content="&#xE74D;"
                                                        ToolTip="{DynamicResource GM.Remove}" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.RemoveProgramCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{DynamicResource GM.Start.Empty}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding SelectedProfile.ProgramsToStart.Count, Converter={StaticResource CountToVis}}" />
                        </Grid>
                    </DockPanel>

                    <!-- ===== Options ===== -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=Options}">
                        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                            <CheckBox IsChecked="{Binding SelectedProfile.SwitchPowerPlan}" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource GM.Opt.Power}" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource GM.Opt.PowerDesc}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding SelectedProfile.DisableNotifications}" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource GM.Opt.Notif}" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource GM.Opt.NotifDesc}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding SelectedProfile.FreeRamOnActivate}" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource GM.Opt.FreeRam}" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource GM.Opt.FreeRamDesc}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding SelectedProfile.RestartKilledOnDeactivate}" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource GM.Opt.Restart}" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource GM.Opt.RestartDesc}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding SelectedProfile.ShowCrosshair}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource GM.Opt.Crosshair}" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource GM.Opt.CrosshairDesc}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="52,0,0,0" IsEnabled="{Binding SelectedProfile.ShowCrosshair}">
                                <TextBlock Text="{DynamicResource GM.Opt.CrosshairPreset}" Foreground="{StaticResource B.TextDim}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox Width="240" ItemsSource="{Binding PresetChoices}" SelectedItem="{Binding SelectedPresetChoice}" DisplayMemberPath="Display" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Automation ===== -->
                    <DockPanel Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=Auto}">
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource GM.Auto.Desc}" Style="{StaticResource Text.Muted}" Margin="0,0,0,10" MaxWidth="760" HorizontalAlignment="Left" />
                        <Border DockPanel.Dock="Top" Style="{StaticResource WarnBox}" Margin="0,0,0,10"
                                Visibility="{Binding AutoSwitchDisabled, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" Foreground="{StaticResource B.Warning}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource GM.Auto.GlobalOff}" Style="{StaticResource Text.Muted}" />
                            </Grid>
                        </Border>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12" MaxWidth="760" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewTriggerName, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource GM.Auto.Placeholder}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddTriggerCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Content="{DynamicResource GM.Auto.AddName}" Command="{Binding AddTriggerCommand}" Margin="8,0,0,0" />
                            <Button Grid.Column="2" Content="{DynamicResource GM.Auto.Browse}" Command="{Binding BrowseTriggerCommand}" Margin="8,0,0,0" />
                        </Grid>
                        <CheckBox DockPanel.Dock="Top" IsChecked="{Binding SelectedProfile.AutoDeactivateOnExit}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource GM.Auto.Deactivate}" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource GM.Auto.DeactivateDesc}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Grid>
                            <ItemsControl ItemsSource="{Binding SelectedProfile.TriggerExecutables}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource B.Bg3}" CornerRadius="16" Padding="14,4,4,4" Margin="0,0,8,8"
                                                BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7FC;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{StaticResource B.Accent}" Margin="0,0,8,0" />
                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                                    <Run Text="{Binding Mode=OneWay}" /><Run Text=".exe" Foreground="{StaticResource B.TextFaint}" />
                                                </TextBlock>
                                                <Button Style="{StaticResource Button.IconGhost}" Width="26" Height="26" FontSize="10" Content="&#xE711;" Margin="6,0,0,0"
                                                        ToolTip="{DynamicResource GM.Remove}" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.RemoveTriggerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource GM.Auto.Empty}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding SelectedProfile.TriggerExecutables.Count, Converter={StaticResource CountToVis}}" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
