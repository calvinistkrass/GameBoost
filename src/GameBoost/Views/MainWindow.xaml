<Window x:Class="GameBoost.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameBoost.ViewModels"
        xmlns:views="clr-namespace:GameBoost.Views"
        Title="GameBoost"
        Width="1240" Height="820"
        MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource B.Bg0}"
        Foreground="{StaticResource B.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Assets/GameBoost.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameModeViewModel}">
            <views:GameModeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CrosshairViewModel}">
            <views:CrosshairView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PerformanceViewModel}">
            <views:PerformanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PcCheckViewModel}">
            <views:PcCheckView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <Style x:Key="NavSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource B.TextFaint}" />
            <Setter Property="Margin" Value="28,16,0,6" />
        </Style>
        <Style x:Key="NavIcon" TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Width" Value="30" />
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource B.TextFaint}" />
        </Style>
    </Window.Resources>

    <Border x:Name="Root" BorderBrush="{StaticResource B.Border}" BorderThickness="1" Background="{StaticResource B.WindowBackground}">
        <Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================= Sidebar ================= -->
                <Border Background="{StaticResource B.Bg1}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,18,0,22">
                            <ContentPresenter ContentTemplate="{StaticResource Logo}" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="Bold">
                                    <Run Text="GAME" /><Run Text="BOOST" Foreground="{StaticResource B.Accent}" />
                                </TextBlock>
                                
                            </StackPanel>
                        </StackPanel>

                        <!-- Status at the bottom -->
                        <Border DockPanel.Dock="Bottom" Margin="14,0,14,16" Padding="12,10" CornerRadius="8"
                                Background="Transparent" BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Status.Title}" Style="{StaticResource Text.Label}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="GmDot" Style="{StaticResource StatusDot}" />
                                    <TextBlock Grid.Column="1" Margin="8,0,6,0" Text="{DynamicResource Nav.GameMode}" Foreground="{StaticResource B.TextDim}" />
                                    <TextBlock Grid.Column="2" Text="{Binding GameModeStatusText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="96" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="ChDot" Style="{StaticResource StatusDot}" />
                                    <TextBlock Grid.Column="1" Margin="8,0,6,0" Text="{DynamicResource Nav.Crosshair}" Foreground="{StaticResource B.TextDim}" />
                                    <TextBlock Grid.Column="2" Text="{Binding CrosshairStatusText}" FontWeight="SemiBold" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="HudDot" Style="{StaticResource StatusDot}" />
                                    <TextBlock Grid.Column="1" Margin="8,0,6,0" Text="{DynamicResource Nav.Performance}" Foreground="{StaticResource B.TextDim}" />
                                    <TextBlock Grid.Column="2" Text="{Binding HudStatusText}" FontWeight="SemiBold" />
                                </Grid>
                                <TextBlock Text="{Binding VersionText}" Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource B.TextFaint}" />
                            </StackPanel>
                        </Border>

                        <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource RadioButton.Nav}" Command="{Binding NavigateCommand}" CommandParameter="Settings" Margin="10,1,10,10"
                                     IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Settings}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="{DynamicResource Nav.Settings}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Navigation -->
                        <StackPanel>
                            <RadioButton Style="{StaticResource RadioButton.Nav}" Command="{Binding NavigateCommand}" CommandParameter="Home"
                                         IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Home}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="{DynamicResource Nav.Home}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource RadioButton.Nav}" Command="{Binding NavigateCommand}" CommandParameter="GameMode"
                                         IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=GameMode}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7FC;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="{DynamicResource Nav.GameMode}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource RadioButton.Nav}" Command="{Binding NavigateCommand}" CommandParameter="PcCheck"
                                         IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=PcCheck}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="{DynamicResource Nav.PcCheck}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource RadioButton.Nav}" Command="{Binding NavigateCommand}" CommandParameter="Crosshair"
                                         IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Crosshair}">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="30">
                                        <Viewbox Width="18" Height="18" HorizontalAlignment="Left">
                                            <Canvas Width="20" Height="20">
                                                <Ellipse Canvas.Left="5" Canvas.Top="5" Width="10" Height="10" StrokeThickness="1.6"
                                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                                <Path Data="M10,1 V6 M10,14 V19 M1,10 H6 M14,10 H19" StrokeThickness="1.6"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Nav.Crosshair}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource RadioButton.Nav}" Command="{Binding NavigateCommand}" CommandParameter="Performance"
                                         IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Performance}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="{DynamicResource Nav.Performance}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ================= Content ================= -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" Click="OnMinimize" ToolTip="{DynamicResource Caption.Minimize}" />
                        <Button x:Name="MaxButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" Click="OnMaximize" ToolTip="{DynamicResource Caption.Maximize}" />
                        <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" Click="OnClose" ToolTip="{DynamicResource Caption.Close}" />
                    </StackPanel>

                    <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="32,0,32,26" Focusable="False" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
