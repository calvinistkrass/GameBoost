<UserControl x:Class="GameBoost.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GameBoost.Controls"
             xmlns:svc="clr-namespace:GameBoost.Services">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,10,20">
            <StackPanel>
                <TextBlock Text="{DynamicResource Sessions.Title}" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{DynamicResource Sessions.Subtitle}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Border Style="{StaticResource Chip}" Margin="0,0,10,0" VerticalAlignment="Center"
                        Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{DynamicResource Sessions.Recording}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource B.Accent}" />
                </Border>
                <Button Style="{StaticResource Button.Ghost}" Command="{Binding ClearCommand}" Content="{DynamicResource Sessions.Clear}" />
            </StackPanel>
        </Grid>

        <!-- Empty state -->
        <Border Grid.Row="1" Style="{StaticResource Card.Glass}" VerticalAlignment="Top"
                Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <StackPanel HorizontalAlignment="Center" Margin="0,30">
                <TextBlock Text="&#xE9D2;" Style="{StaticResource Text.Icon}" FontSize="30" HorizontalAlignment="Center" Foreground="{StaticResource B.Accent}" />
                <TextBlock Text="{DynamicResource Sessions.EmptyTitle}" Style="{StaticResource Text.H2}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="{DynamicResource Sessions.Empty}" Style="{StaticResource Text.Muted}" TextAlignment="Center" MaxWidth="460" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- List -->
            <Border Style="{StaticResource Card.Glass}" Padding="8">
                <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type svc:SessionRecord}">
                            <StackPanel Margin="4,4">
                                <TextBlock Text="{Binding Game}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource Text.Muted}" FontSize="11.5">
                                    <Run Text="{Binding Start, StringFormat=g, Mode=OneWay}" />
                                    <Run Text="·" />
                                    <Run Text="{Binding AvgFps, StringFormat={}{0:0} FPS, Mode=OneWay, TargetNullValue=–}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Report -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource PageRoot}">
                <StackPanel Margin="0,0,10,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card.Accent}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" />
                                    <TextBlock Text="{Binding When}" Style="{StaticResource Text.Muted}" Margin="0,2,0,16" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Button.IconGhost}" Content="&#xE74D;"
                                        ToolTip="{DynamicResource Sessions.Delete}" Command="{Binding DeleteCommand}" />
                            </Grid>
                            <UniformGrid Columns="4" Rows="2">
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{DynamicResource Sessions.AvgFps}" Style="{StaticResource Text.StatLabel}" />
                                    <TextBlock Text="{Binding AvgFps}" Style="{StaticResource Text.StatValue}" Foreground="{StaticResource B.Accent}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Sessions.LowFps}" Style="{StaticResource Text.StatLabel}" />
                                    <TextBlock Text="{Binding LowFps}" Style="{StaticResource Text.StatValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Sessions.MaxFps}" Style="{StaticResource Text.StatLabel}" />
                                    <TextBlock Text="{Binding MaxFps}" Style="{StaticResource Text.StatValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Sessions.MaxTemp}" Style="{StaticResource Text.StatLabel}" />
                                    <TextBlock Text="{Binding MaxTemp}" Style="{StaticResource Text.StatValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Sessions.AvgGpu}" Style="{StaticResource Text.StatLabel}" />
                                    <TextBlock Text="{Binding AvgGpu}" Style="{StaticResource Text.StatValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Sessions.AvgCpu}" Style="{StaticResource Text.StatLabel}" />
                                    <TextBlock Text="{Binding AvgCpu}" Style="{StaticResource Text.StatValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Sessions.MaxRam}" Style="{StaticResource Text.StatLabel}" />
                                    <TextBlock Text="{Binding MaxRam}" Style="{StaticResource Text.StatValue}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card.Glass}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Sessions.FpsChart}" Style="{StaticResource Text.H2}" Margin="0,0,0,12" />
                            <controls:LineChart Height="150" Values="{Binding FpsTimeline}" Stroke="{StaticResource B.Accent}" GridBrush="{StaticResource B.TextFaint}"
                                                Visibility="{Binding HasFps, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{DynamicResource Sessions.NoFps}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                       Visibility="{Binding HasFps, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card.Glass}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Sessions.TempChart}" Style="{StaticResource Text.H2}" Margin="0,0,0,12" />
                            <controls:LineChart Height="150" Values="{Binding TempTimeline}" Stroke="{StaticResource B.Warning}" GridBrush="{StaticResource B.TextFaint}" Unit="°"
                                                Visibility="{Binding HasTemp, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{DynamicResource Sessions.NoTemp}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                       Visibility="{Binding HasTemp, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
