<UserControl x:Class="GameBoost.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TileIcon" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource B.Bg3}" />
        </Style>
        <Style x:Key="StatBlock" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource PageRoot}">
        <StackPanel Margin="0,0,10,0">
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="{DynamicResource Nav.Home}" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{DynamicResource Home.Subtitle}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Update banner -->
            <Border Style="{StaticResource InfoBox}" Margin="0,0,0,16" Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE896;" Style="{StaticResource Text.Icon}" Foreground="{StaticResource B.Accent}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding UpdateText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Padding="12,6" Content="{Binding InstallUpdateText}" Command="{Binding InstallUpdateCommand}" />
                </Grid>
            </Border>

            <!-- Quick toggles -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource Button.Tile}" Tag="{Binding GameModeActive}" Command="{Binding ToggleGameModeCommand}" ToolTip="{DynamicResource Home.ClickToToggle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Border Style="{StaticResource TileIcon}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE7E8;" Style="{StaticResource Text.Icon}" HorizontalAlignment="Center" Foreground="{StaticResource B.Accent}" />
                            </Border>
                            <TextBlock Text="{Binding GameModeState}" Style="{StaticResource Text.StatValue}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{DynamicResource Nav.GameMode}" Style="{StaticResource Text.H2}" Margin="0,14,0,2" />
                        <TextBlock Grid.Row="2" Text="{Binding GameModeDetail}" Style="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </Grid>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource Button.Tile}" Tag="{Binding CrosshairVisible}" Command="{Binding ToggleCrosshairCommand}" ToolTip="{DynamicResource Home.ClickToToggle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Border Style="{StaticResource TileIcon}" HorizontalAlignment="Left">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="20" Height="20">
                                        <Ellipse Canvas.Left="5" Canvas.Top="5" Width="10" Height="10" StrokeThickness="1.8" Stroke="{StaticResource B.Accent}" />
                                        <Path Data="M10,1 V6 M10,14 V19 M1,10 H6 M14,10 H19" StrokeThickness="1.8" Stroke="{StaticResource B.Accent}" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="{Binding CrosshairState}" Style="{StaticResource Text.StatValue}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{DynamicResource Nav.Crosshair}" Style="{StaticResource Text.H2}" Margin="0,14,0,2" />
                        <TextBlock Grid.Row="2" Text="{Binding CrosshairDetail}" Style="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </Grid>
                </Button>

                <Button Grid.Column="4" Style="{StaticResource Button.Tile}" Tag="{Binding HudVisible}" Command="{Binding ToggleHudCommand}" ToolTip="{DynamicResource Home.ClickToToggle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Border Style="{StaticResource TileIcon}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE945;" Style="{StaticResource Text.Icon}" HorizontalAlignment="Center" Foreground="{StaticResource B.Accent}" />
                            </Border>
                            <TextBlock Text="{Binding HudState}" Style="{StaticResource Text.StatValue}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{DynamicResource Nav.Performance}" Style="{StaticResource Text.H2}" Margin="0,14,0,2" />
                        <TextBlock Grid.Row="2" Text="{Binding HudDetail}" Style="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </Grid>
                </Button>
            </Grid>

            <!-- Live stats + PC score -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card.Glass}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource Home.LiveTitle}" Style="{StaticResource Text.H2}" />
                        </Grid>
                        <UniformGrid Columns="4">
                            <StackPanel Style="{StaticResource StatBlock}">
                                <TextBlock Text="CPU" Style="{StaticResource Text.StatLabel}" />
                                <TextBlock Text="{Binding CpuText}" Style="{StaticResource Text.StatValue}" Margin="0,2,0,8" />
                                <ProgressBar Style="{StaticResource Meter}" Value="{Binding CpuValue, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource StatBlock}">
                                <TextBlock Text="GPU" Style="{StaticResource Text.StatLabel}" />
                                <TextBlock Text="{Binding GpuText}" Style="{StaticResource Text.StatValue}" Margin="0,2,0,8" />
                                <ProgressBar Style="{StaticResource Meter}" Value="{Binding GpuValue, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource StatBlock}">
                                <TextBlock Text="{DynamicResource Home.GpuTemp}" Style="{StaticResource Text.StatLabel}" />
                                <TextBlock Text="{Binding GpuTempText}" Style="{StaticResource Text.StatValue}" Margin="0,2,0,8" />
                                <ProgressBar Style="{StaticResource Meter}" Value="{Binding GpuTempValue, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource StatBlock}" Margin="0">
                                <TextBlock Text="RAM" Style="{StaticResource Text.StatLabel}" />
                                <TextBlock Text="{Binding RamText}" Style="{StaticResource Text.StatValue}" FontSize="22" Margin="0,8,0,10" />
                                <ProgressBar Style="{StaticResource Meter}" Value="{Binding RamValue, Mode=OneWay}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,14,0,0">
                            <Run Text="VRAM:" /> <Run Text="{Binding VramText, Mode=OneWay}" Foreground="{StaticResource B.Text}" />
                            <Run Text="  ·  " /><Run Text="{DynamicResource Home.LiveHint}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card.Accent}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Home.ScoreTitle}" Style="{StaticResource Text.H2}" />
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Command="{Binding NavigateCommand}" CommandParameter="PcCheck">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Home.OpenCheck}" />
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ScoreText}" FontFamily="{StaticResource DisplayFont}" FontSize="44" FontWeight="SemiBold" Foreground="{StaticResource B.Accent}" />
                                <TextBlock Text="/100" FontFamily="{StaticResource DisplayFont}" FontSize="18" Foreground="{StaticResource B.TextDim}" VerticalAlignment="Bottom" Margin="4,0,0,12" />
                            </StackPanel>
                            <TextBlock Text="{Binding ScoreLabel}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding OpenIssuesText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
            <!-- Last session -->
            <Border Style="{StaticResource Card.Glass}" Margin="0,16,0,0" Visibility="{Binding HasLastSession, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Home.LastSessionTitle}" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding LastSessionText}" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Button.Ghost}" Content="{DynamicResource Home.AllSessions}"
                            Command="{Binding NavigateCommand}" CommandParameter="Sessions" />
                </Grid>
            </Border>
</StackPanel>
    </ScrollViewer>
</UserControl>
