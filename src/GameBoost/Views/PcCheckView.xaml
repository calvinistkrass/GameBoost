<UserControl x:Class="GameBoost.Views.PcCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:check="clr-namespace:GameBoost.Services.SystemCheck"
             xmlns:svc="clr-namespace:GameBoost.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource PageRoot}">
        <StackPanel Margin="0,0,10,0">
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource PC.Title}" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="{DynamicResource PC.Subtitle}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{Binding RescanCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource PC.Rescan}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Score + hardware -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.6*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card.Accent}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Home.ScoreTitle}" Style="{StaticResource Text.H2}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding ScoreText}" FontFamily="{StaticResource DisplayFont}" FontSize="44" FontWeight="SemiBold" Foreground="{StaticResource B.Accent}" />
                            <TextBlock Text="/100" FontFamily="{StaticResource DisplayFont}" FontSize="18" Foreground="{StaticResource B.TextDim}" VerticalAlignment="Bottom" Margin="4,0,0,13" />
                        </StackPanel>
                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding ScoreValue, Mode=OneWay}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding ScoreLabel}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Muted}" Margin="0,2,0,14" />
                        <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Command="{Binding FixAllCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource PC.FixAll}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card.Glass}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="{DynamicResource Home.SystemTitle}" Style="{StaticResource Text.H2}" />
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" Margin="0">
                                <TextBlock Text="{Binding Tier}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource B.Accent}" />
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Home.Cpu}" Style="{StaticResource Text.StatLabel}" Margin="0,0,0,10" />
                            <TextBlock Grid.Column="1" Text="{Binding Cpu}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Text="{DynamicResource Home.Gpu}" Style="{StaticResource Text.StatLabel}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Gpu}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Text="{DynamicResource Home.Memory}" Style="{StaticResource Text.StatLabel}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Memory}" />
                            <TextBlock Grid.Row="3" Text="{DynamicResource Home.Display}" Style="{StaticResource Text.StatLabel}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Display}" />
                            <TextBlock Grid.Row="4" Text="{DynamicResource PC.Os}" Style="{StaticResource Text.StatLabel}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Os}" />
                        </Grid>
                        <TextBlock Text="{Binding TierDescription}" Style="{StaticResource Text.Muted}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Windows checks -->
            <Border Style="{StaticResource Card.Glass}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource PC.ChecksTitle}" Style="{StaticResource Text.H2}" />
                    <TextBlock Text="{DynamicResource PC.ChecksDesc}" Style="{StaticResource Text.Muted}" Margin="0,4,0,14" />
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Checks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type check:SystemCheckItem}">
                                    <Border Background="{StaticResource B.Bg3}" CornerRadius="12" Padding="14,12" Margin="0,0,0,8"
                                            BorderBrush="{StaticResource B.Border}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="IconBg" Width="34" Height="34" CornerRadius="10" Background="{StaticResource B.AccentSoft}" VerticalAlignment="Top" Margin="0,0,14,0">
                                                <TextBlock x:Name="Icon" Text="&#xE73E;" Style="{StaticResource Text.Icon}" FontSize="14" HorizontalAlignment="Center" Foreground="{StaticResource B.Accent}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" Margin="0,2,12,0" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Current}" FontSize="11.5" FontWeight="SemiBold" />
                                            </Border>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource Button.Primary}" Padding="12,6" Margin="0,0,6,0"
                                                        Content="{DynamicResource PC.Fix}" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Visibility="{Binding CanFix, Converter={StaticResource BoolToVis}}" />
                                                <Button Padding="12,6" Margin="0,0,6,0"
                                                        CommandParameter="{Binding}" ToolTip="{DynamicResource PC.UndoTip}"
                                                        Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE7A7;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,6,0" />
                                                        <TextBlock Text="{DynamicResource PC.Undo}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource Button.IconGhost}" Content="&#xE8A7;" ToolTip="{DynamicResource PC.OpenTip}" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static check:CheckStatus.Recommended}">
                                            <Setter TargetName="Icon" Property="Text" Value="&#xE945;" />
                                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource B.Accent2}" />
                                            <Setter TargetName="IconBg" Property="Background" Value="{StaticResource B.InfoSoft}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static check:CheckStatus.Info}">
                                            <Setter TargetName="Icon" Property="Text" Value="&#xE946;" />
                                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource B.TextDim}" />
                                            <Setter TargetName="IconBg" Property="Background" Value="{StaticResource B.Bg4}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static check:CheckStatus.Warning}">
                                            <Setter TargetName="Icon" Property="Text" Value="&#xE7BA;" />
                                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource B.Warning}" />
                                            <Setter TargetName="IconBg" Property="Background" Value="{StaticResource B.WarningSoft}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{DynamicResource Home.Analyzing}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,20"
                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Cleanup -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.6*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card.Glass}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource PC.RamTitle}" Style="{StaticResource Text.H2}" />
                        <TextBlock Text="{DynamicResource PC.RamDesc}" Style="{StaticResource Text.Muted}" Margin="0,4,0,14" TextWrapping="Wrap" />
                        <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Command="{Binding FreeRamCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE964;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource PC.RamFree}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding RamResult}" Foreground="{StaticResource B.Accent}" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card.Glass}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource PC.CleanTitle}" Style="{StaticResource Text.H2}" />
                        <TextBlock Text="{DynamicResource PC.CleanDesc}" Style="{StaticResource Text.Muted}" Margin="0,4,0,14" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Cleanup}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type svc:CleanupCategory}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" Margin="0,2,12,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </CheckBox>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="{Binding CleanResult}" Foreground="{StaticResource B.Accent}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,260,0" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding ScanCleanupCommand}" Margin="0,0,8,0" Content="{DynamicResource PC.CleanScan}" />
                                <Button Style="{StaticResource Button.Primary}" Command="{Binding CleanCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="{DynamicResource PC.CleanNow}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recommended in-game settings -->
            <Border Style="{StaticResource Card.Glass}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource PC.GameTitle}" Style="{StaticResource Text.H2}" />
                    <TextBlock Text="{DynamicResource PC.GameDesc}" Style="{StaticResource Text.Muted}" Margin="0,4,0,14" />
                    <ItemsControl ItemsSource="{Binding Recommendations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type check:GameSettingRecommendation}">
                                <Border BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Setting}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource B.Accent}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Why}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
