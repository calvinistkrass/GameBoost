<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>GameBoost</AssemblyName>
    <RootNamespace>GameBoost</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\GameBoost.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>GameBoost</Product>
    <Description>Game mode and crosshair overlay for Windows</Description>
    <Copyright>© 2026 GameBoost</Copyright>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <!-- WFAC010 only applies to pure WinForms apps; for WPF the DPI manifest is correct. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- WinForms is only used for the tray icon and the color dialog;
       its global usings would otherwise clash with WPF types. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\GameBoost.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameBoost.Tests" />
  </ItemGroup>

</Project>
